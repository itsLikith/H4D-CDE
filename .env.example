# ==============================================================================
# H4D-CDE (Hexagonal 4D Conflict-Detection Engine)
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as required for your environment.
# All microservices and orchestration tooling read from these values.

# ------------------------------------------------------------------------------
# General / Runtime
# ------------------------------------------------------------------------------
ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Network Ports (External & Internal)
# ------------------------------------------------------------------------------
# Web Dashboard
WEB_PORT=3000

# API Gateway (REST BFF & WebSocket Server)
GATEWAY_PORT=8080

# Internal Go Microservices (gRPC)
STANDARDS_SVC_GRPC_PORT=50050
VOXEL_ENGINE_GRPC_PORT=50051
AUDIT_SVC_GRPC_PORT=50054

# Internal Python ML Microservices (gRPC)
TRAJECTORY_PREDICTOR_GRPC_PORT=50052
DEMAND_FORECASTER_GRPC_PORT=50053
RISK_SCORER_GRPC_PORT=50055

# ------------------------------------------------------------------------------
# Service Hostnames (For local dev / Docker Compose)
# ------------------------------------------------------------------------------
GATEWAY_HOST=localhost
STANDARDS_SVC_HOST=localhost
VOXEL_ENGINE_HOST=localhost
AUDIT_SVC_HOST=localhost
TRAJECTORY_PREDICTOR_HOST=localhost
DEMAND_FORECASTER_HOST=localhost
RISK_SCORER_HOST=localhost

# ------------------------------------------------------------------------------
# Shared Infrastructure (Redis, Kafka, PostgreSQL / TimescaleDB)
# ------------------------------------------------------------------------------
# Redis (Occupancy Store & Forecast Cache)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_OCCUPANCY_TTL_SECONDS=120

# Kafka / Redpanda (Audit & Conflict Event Streaming)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_AUDIT_EVENTS=audit.events
KAFKA_TOPIC_CONFLICTS_DETECTED=conflicts.detected
KAFKA_CONSUMER_GROUP_AUDIT=audit-svc-group
KAFKA_CONSUMER_GROUP_GATEWAY=gateway-ws-group

# PostgreSQL / TimescaleDB (Flight Plans & Durable Audit Trail)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=h4d
POSTGRES_PASSWORD=h4d_secure_password
POSTGRES_DB=h4d_cde
POSTGRES_SSLMODE=disable

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_signing_key_change_in_production
AUTH_ENABLED=false

# ------------------------------------------------------------------------------
# Aviation & Spatial Separation Defaults (ASTM F3548-21 & ICSPIS 2025 Paper)
# ------------------------------------------------------------------------------
CONFIG_SEPARATION_PATH=config/separation_params.yaml
DEFAULT_H3_RESOLUTION=8
DEFAULT_ALTITUDE_BIN_FT=100
DEFAULT_TIME_BIN_S=10
DEFAULT_HORIZONTAL_SEPARATION_NM=5.0
DEFAULT_VERTICAL_SEPARATION_FT=1000.0
DEFAULT_TEMPORAL_BUFFER_S=60.0
DEFAULT_RISK_THRESHOLD=0.50

# ------------------------------------------------------------------------------
# Machine Learning Model Paths
# ------------------------------------------------------------------------------
TRAJECTORY_PREDICTOR_MODEL_PATH=models/trajectory_predictor.joblib
DEMAND_FORECASTER_MODEL_PATH=models/demand_forecaster.pt
RISK_SCORER_MODEL_PATH=models/risk_scorer.joblib
